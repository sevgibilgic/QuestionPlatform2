@{
    ViewData["Title"] = "Users Page";

    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}
@model List<QuestionPlatform2.Models.User>

<h2>Tüm Kullanıcılar</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Ad Soyad</th>
            <th>Kullanıcı Adı</th>
            <th>Email</th>
            <th>Rol</th>
            <th>Fotoğraf</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.FullName</td>
                <td>@user.UserName</td>
                <td>@user.Email</td>
                <td>@user.Role</td>
                <td>
                    @if (!string.IsNullOrEmpty(user.PhotoUrl))
                    {
                        <img src="@user.PhotoUrl" alt="Foto" width="50" height="50" />
                    }
                    else
                    {
                        <span>Yok</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
