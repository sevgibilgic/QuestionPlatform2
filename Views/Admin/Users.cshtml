@{
    ViewData["Title"] = "Kullanıcılar";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}
@model List<QuestionPlatform2.ViewModels.UserRoleModel>

<h2>Kullanıcı & Rol Yönetimi</h2>

<p class="fs-2 fw-bold">Toplam Kullanıcı: <span id="userCount">@Model.Count</span></p>
<script src="~/js/signalr.js"></script>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Kullanıcı</th>
            <th>Email</th>
            <th>Roller</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td>@u.UserName</td>
                <td>@u.Email</td>
                <td>
                    @foreach (var role in u.AllRoles)
                    {
                        <form asp-action="UpdateRole" method="post" style="display:inline;">
                            <input type="hidden" name="userId" value="@u.UserId" />
                            <input type="hidden" name="role" value="@role" />

                            <input type="checkbox"
                                   name="isInRole"
                                   value="true"
                                   onchange="this.form.submit()"
                                   @(u.Roles.Contains(role) ? "checked" : "") />

                            <label>@role</label>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
<script>
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/general-hub")
        .build();

    connection.on("onUserAdded", function (count) {
        document.getElementById("userCount").innerText = count;
    });

    connection.start().catch(err => console.error(err.toString()));
</script>
