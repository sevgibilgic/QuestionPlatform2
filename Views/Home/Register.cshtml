@{
    Layout = null;
}
@model QuestionPlatform2.ViewModels.RegisterModel

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <title>Yeni Kayıt</title>

    <!-- Custom fonts for this template-->
    <link href="~/sbadmin/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
    <link href="https://fonts.googleapis.com/css?family=Nunito" rel="stylesheet">

    <!-- Custom styles for this template-->
    <link href="~/sbadmin/css/sb-admin-2.min.css" rel="stylesheet">

</head>

<body class="bg-gradient-primary">

    <div class="container">

        <div class="row justify-content-center">
            <div class="col-xl-10 col-lg-6 col-md-9">

                <div class="card o-hidden border-0 shadow-lg my-5">
                    <div class="card-body p-0">

                        <div class="row">
                            <div class="col-lg-12">

                                <div class="p-5">

                                    <div class="text-center">
                                        <h1 class="h4 text-gray-900 mb-4">Yeni Kayıt</h1>
                                    </div>

                                    <!-- ✔ HATALARI BURADA GÖSTER -->
                                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                                    <form class="user" asp-controller="Home" asp-action="Register" method="post" enctype="multipart/form-data">

                                        <div class="form-group">
                                            <input class="form-control form-control-user"
                                                   asp-for="UserName" placeholder="Kullanıcı Adı">
                                            <span asp-validation-for="UserName" class="text-danger"></span>
                                        </div>

                                        <div class="form-group">
                                            <input class="form-control form-control-user"
                                                   asp-for="Email" placeholder="E-Posta Adresi">
                                            <span asp-validation-for="Email" class="text-danger"></span>
                                        </div>

                                        <div class="form-group">
                                            <input class="form-control form-control-user"
                                                   asp-for="FullName" placeholder="Adı Soyadı">
                                            <span asp-validation-for="FullName" class="text-danger"></span>
                                        </div>

                                        <div class="form-group">
                                            <input type="password" class="form-control form-control-user"
                                                   asp-for="Password" placeholder="Parola">
                                            <span asp-validation-for="Password" class="text-danger"></span>
                                        </div>

                                        <div class="form-group">
                                            <input type="password" class="form-control form-control-user"
                                                   asp-for="PasswordConfirm" placeholder="Parola Tekrar">
                                            <span asp-validation-for="PasswordConfirm" class="text-danger"></span>
                                        </div>

                                        <div class="form-group">
                                            <input type="file" class="form-control" asp-for="PhotoFile">
                                            <span asp-validation-for="PhotoFile" class="text-danger"></span>
                                        </div>

                                        <input type="submit" class="btn btn-primary btn-user btn-block" value="Kayıt Ol" />

                                    </form>

                                    <hr>

                                    <div class="text-center">
                                        <a class="small" asp-action="Login">Oturum Aç</a>
                                    </div>

                                </div>

                            </div>
                        </div>

                    </div>
                </div>

            </div>
        </div>

    </div>

    <!-- Bootstrap core JavaScript-->
    <script src="~/sbadmin/vendor/jquery/jquery.min.js"></script>
    <script src="~/sbadmin/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>

    <!-- Validation -->
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.min.js"></script>

    <!-- Core plugin JavaScript-->
    <script src="~/sbadmin/vendor/jquery-easing/jquery.easing.min.js"></script>

    <!-- Custom scripts for all pages-->
    <script src="~/sbadmin/js/sb-admin-2.min.js"></script>

    @await Component.InvokeAsync("Notyf")

</body>

</html>
