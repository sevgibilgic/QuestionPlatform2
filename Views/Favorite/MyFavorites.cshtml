@{
    Layout = "_LayoutAdmin"; 
}

@model List<QuestionPlatform2.Models.Favorite>

@section CardHeader {
    <span>Favorilerim</span>
}

<h2>Favori Sorularım</h2>
<hr />

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">
        Henüz favoriye eklediğin bir soru yok.
    </div>
}
else
{
    <div class="list-group">

        @foreach (var fav in Model)
        {
            <div class="list-group-item">
                <h4>@fav.Question.Title</h4>

                <p>
                    @fav.Question.Content.Substring(0,
                    Math.Min(150, fav.Question.Content.Length))...

        </p>

        <a href="/Question/Details/@fav.QuestionId" class="btn btn-primary btn-sm">
            Detayları Gör
        </a>

        <button class="btn btn-danger btn-sm btnRemoveFavorite"
                data-id="@fav.Id">
            Favoriden Çıkar
        </button>

    </div>
        }

    </div>
}

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    $(".btnRemoveFavorite").click(function () {
        var id = $(this).data("id");

        $.ajax({
            url: "/Favorite/DeleteAjax?id=" + id,
            type: "POST",
            success: function (res) {
                alert(res.message);
                location.reload();
            },
            error: function () {
                alert("Favori silinemedi.");
            }
        });
    });
</script>
