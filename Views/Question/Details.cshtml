@{
    Layout = "_LayoutAdmin";
}
@model QuestionPlatform2.ViewModels.QuestionModel

@section CardHeader {

}

<div class="container mt-4">

    <h2 class="fs-2 fw-bold mb-3">@Model.Title</h2>

    <p class="fs-5">@Model.Content</p>

    <hr class="my-4" />

    <button id="btnFavorite"
            data-question="@Model.Id"
            data-user="1"
            class="btn btn-outline-danger btn-lg mb-4 px-4">
        ❤️ Favori
    </button>

    <h3 class="fs-3 fw-semibold mt-4">Cevaplar:</h3>

    @if (Model.Answers == null || !Model.Answers.Any())
    {
        <p class="fs-4 mt-2">Bu soruya henüz cevap eklenmemiş.</p>
    }
    else
    {
        @foreach (var a in Model.Answers)
        {
            <div class="fs-4 mt-3 p-3 border rounded shadow-sm">
                @a.AnswerContent
            </div>
        }
    }


</div>

<script>
    $(document).ready(function() {
        $("#btnFavorite").click(function () {

            var questionId = $(this).data("question");
            var userId = $(this).data("user");

            $.ajax({
                url: "/Favorite/ToggleAjax",
                type: "POST",
                data: {
                    QuestionId: questionId,
                    UserId: userId
                },
                success: function (res) {
                    if (res.data && res.data.isFavorite) {
                        $("#btnFavorite").text("💔 Favoriden Çıkar");
                    } else {
                        $("#btnFavorite").text("❤️ Favori");
                    }

                    alert(res.message);
                },
                error: function(xhr, status, error) {
                    console.error("AJAX Hatası:", status, error);
                    alert("Favorilere ekleme sırasında bir hata oluştu!");
                }
            });
        });
    });
</script>