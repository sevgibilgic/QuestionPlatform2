@{
    Layout = "_LayoutAdmin";
}
@model QuestionPlatform2.ViewModels.QuestionModel

@section CardHeader {
    <span class="fs-4 fw-bold">Soru Ekle</span>
}

<div class="row d-flex justify-content-center mt-4">
    <div class="col-md-6">

        <div class="card shadow-sm p-4">

            <form asp-controller="Question" asp-action="Add" method="post">

                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-semibold fs-5"></label>
                    <input asp-for="Title" class="form-control form-control-lg" />
                    <span class="text-danger" asp-validation-for="Title"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Content" class="form-label fw-semibold fs-5"></label>
                    <textarea asp-for="Content" rows="4" class="form-control form-control-lg"></textarea>
                    <span class="text-danger" asp-validation-for="Content"></span>
                </div>

                @if (User.IsInRole("Admin"))
                {
                    <div class="form-check mb-3 ms-1">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label fs-5 ms-1"></label>
                    </div>
                }

                <div class="text-end">
                    <button type="submit" class="btn btn-primary btn-lg px-4">Kaydet</button>
                </div>

            </form>

        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
