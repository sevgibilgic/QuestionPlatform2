@{
    Layout = "_LayoutAdmin";
}
@section CardHeader {
    <span>Sorularım</span>
}
@model List<QuestionPlatform2.ViewModels.QuestionModel>


<a asp-action="Add" asp-controller="Question" class="btn btn-primary btn-sm mb-2">Ekle</a>

@if (Model.Count == 0)
{
    <div class="alert alert-danger col-md-4 mb-2">Henüz Soru Eklenmedi!</div>
}
<table class="table">
    <thead>
        <tr>
            <td>Başlık</td>
            <td>İçerik</td>
            <td>Oluşturulma Tarihi</td>
            <td>Güncellenme Tarihi</td>
        </tr>
    </thead>
    <tbody>
        @foreach (var question in Model)
        {
            <tr>
                <td>@question.Title</td>
                <td>@question.Content</td>
                <td>@question.CreatedAt</td>
                <td>@question.UpdatedAt</td>
                <td>
                    @if (question.IsActive)
                    {
                        <span class="badge bg-success text-white">Aktif</span>
                    }
                    else
                    {
                        <span class="badge bg-danger text-white">Pasif</span>
                    }


                </td>
                <td>
                    <a asp-action="Update" asp-controller="Question" class="btn btn-primary btn-sm" asp-route-id="@question.Id">Düzenle</a>
                    <a asp-action="Delete" asp-controller="Question" class="btn btn-danger btn-sm" asp-route-id="@question.Id">Sil</a>
                    <a asp-action="Details" asp-controller="Question" class="btn btn-danger btn-sm" asp-route-id="@question.Id">Detaylar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
