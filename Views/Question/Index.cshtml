@{
    Layout = "_LayoutAdmin";
}
@section CardHeader {
    <span class="fs-4 fw-bold">Sorular</span>
}
@model List<QuestionPlatform2.ViewModels.QuestionModel>

<p class="fs-2 fw-bold">Toplam Soru: <span id="questionCount">@Model.Count</span></p>

<script src="~/js/signalr.js"></script>
<script>
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/general-hub")
        .build();

    connection.on("onQuestionAdded", function (count) {
        document.getElementById("questionCount").innerText = count;
    });

    connection.start().catch(err => console.error(err.toString()));
</script>

<a asp-action="Add" asp-controller="Question" class="btn btn-primary btn-lg mb-3">➕ Ekle</a>

@if (Model.Count == 0)
{
    <div class="alert alert-danger col-md-4 mb-3 fs-5">Henüz Soru Eklenmedi!</div>
}

<table class="table table-bordered table-striped table-lg fs-5">
    <thead class="table-dark">
        <tr>
            <th>Başlık</th>
            <th>İçerik</th>
            <th>Oluşturulma</th>
            <th>Güncellenme</th>
            @if (User.IsInRole("Admin"))
            {
                <th>Durum</th>
            }
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var question in Model)
        {
            <tr>
                <td>@(question.Title?.Length > 50 ? question.Title.Substring(0, 50) + "..." : question.Title)</td>
                <td>@(question.Content?.Length > 80 ? question.Content.Substring(0, 80) + "..." : question.Content)</td>
                <td>@question.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                <td>@question.UpdatedAt.ToString("dd.MM.yyyy HH:mm")</td>

                @if (User.IsInRole("Admin"))
                {
                    <td>
                        @if (question.IsActive)
                        {
                            <span class="badge bg-success fs-6">Aktif</span>
                        }
                        else
                        {
                            <span class="badge bg-danger fs-6">Pasif</span>
                        }
                    </td>
                }

                <td style="white-space: nowrap;">
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Update" asp-controller="Question" asp-route-id="@question.Id" class="btn btn-primary btn-sm mb-1">Düzenle</a>
                        <a asp-action="Delete" asp-controller="Question" asp-route-id="@question.Id" class="btn btn-danger btn-sm mb-1">Sil</a>
                    }
                    <a asp-action="Details" asp-controller="Question" asp-route-id="@question.Id" class="btn btn-secondary btn-sm mb-1">Detaylar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
