@{
    Layout = "_LayoutAdmin";
}
@model QuestionPlatform2.ViewModels.QuestionModel
@section CardHeader {
    <span>Soru Düzenle</span>
}

<div class="row">
    <div class="col-md-6 col-lg-5 mx-auto">
        <form asp-controller="Question" asp-action="Update" method="post">

            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control form-control-lg" />
                <span class="text-danger" asp-validation-for="Title"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Content" class="form-label"></label>
                <textarea asp-for="Content" class="form-control form-control-lg" rows="5"></textarea>
                <span class="text-danger" asp-validation-for="Content"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label"></label>
                <span class="text-danger" asp-validation-for="IsActive"></span>
            </div>

            <div class="mb-3 text-center">
                <input type="submit" value="Kaydet" class="btn btn-primary btn-lg px-5" />
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
